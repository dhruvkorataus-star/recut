generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JobSource {
  YOUTUBE
  UPLOAD
}

enum JobStatus {
  QUEUED
  FETCHING
  TRANSCRIBING
  GENERATING
  DONE
  FAILED
}

enum ResultKind {
  THREAD
  LINKEDIN
  BLOG
  CLIPS
}

model Job {
  id          String    @id @default(uuid())
  source      JobSource
  sourceUrl   String?
  fileName    String?
  title       String?
  status      JobStatus @default(QUEUED)
  error       String?
  transcript  String?
  durationSec Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  segments Segment[]
  results  Result[]
}

model Segment {
  id        String   @id @default(uuid())
  idx       Int
  startSec  Float
  endSec    Float
  text      String
  createdAt DateTime @default(now())

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model Result {
  id        String     @id @default(uuid())
  kind      ResultKind
  content   String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, kind])
  @@index([jobId])
}
